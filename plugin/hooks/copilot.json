{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "/bin/sh \"${COPILOT_PLUGIN_ROOT}/scripts/tracekit-hook\" preToolUse copilot",
        "timeoutSec": 600
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "/bin/sh \"${COPILOT_PLUGIN_ROOT}/scripts/tracekit-hook\" postToolUse copilot",
        "timeoutSec": 30
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "/bin/sh \"${COPILOT_PLUGIN_ROOT}/scripts/tracekit-hook\" postToolUseFailure copilot",
        "timeoutSec": 30
      }
    ]
  }
}
