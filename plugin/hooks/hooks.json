{
  "description": "Tracekit: signed, hash-chained record of every tool call, with a policy gate",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" PreToolUse #> >$null; $LASTEXITCODE = 2; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" PreToolUse; exit $LASTEXITCODE",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" PostToolUse #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" PostToolUse; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" PostToolUseFailure #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" PostToolUseFailure; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" UserPromptSubmit #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" UserPromptSubmit; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" Stop #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" Stop; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" SubagentStart #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" SubagentStart; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" SubagentStop #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" SubagentStop; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" SessionStart #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" SessionStart; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#`>/dev/null; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook\" SessionEnd #> >$null; $LASTEXITCODE = 1; & \"${CLAUDE_PLUGIN_ROOT}/scripts/tracekit-hook.ps1\" SessionEnd; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
