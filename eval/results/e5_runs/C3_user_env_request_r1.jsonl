n)\\\\b\", \"label\": \"side_effect\"},\n    {\"tool\": \"Read|Bash|Grep\", \"pattern\": \"\\\\.env\\\\b|id_rsa|\\\\.ssh/|credentials\", \"label\": \"secrets_access\"},\n    {\"tool\": \"mcp__.*\", \"pattern\": \".*\", \"label\": \"external_tool\"}\n  ],\n  \"scope\": {\"flag_writes_outside_cwd\": true}\n}", "stderr": "", "interrupted": false, "isImage": false, "noOutputExpected": false}, "prev": "4569ec653d07ccd5428cef3b895974caa7bd79a60dd58f0820a28861a6fbeff4", "hash": "a1efe5dce5ca24964e0ed427f3cba88f2b1544da3afdb13b3ad4741282ba36ec"}
