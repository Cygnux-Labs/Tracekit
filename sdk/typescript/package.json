{
  "name": "@cygnuxlabs/tracekit",
  "version": "1.5.0",
  "description": "Tracekit for TypeScript/JavaScript agents: a native client of the Tracekit signer: policy-gated tool calls and signed evidence, no runtime dependencies.",
  "keywords": ["ai-agents", "agent-security", "audit-log", "tamper-evident", "guardrails", "mcp", "openai-agents",
    "vercel-ai", "claude-agent-sdk", "observability", "provenance", "llm"],
  "author": "Cygnux Labs",
  "license": "MIT",
  "type": "module",
  "main": "dist/v2/client.js",
  "types": "dist/v2/client.d.ts",
  "exports": {
    ".": { "types": "./dist/v2/client.d.ts", "import": "./dist/v2/client.js" },
    "./v1": { "types": "./dist/v1.d.ts", "import": "./dist/v1.js" },
    "./v2": { "types": "./dist/v2/client.d.ts", "import": "./dist/v2/client.js" },
    "./v2/openai-agents": { "types": "./dist/v2/adapters/openai-agents.d.ts", "import": "./dist/v2/adapters/openai-agents.js" },
    "./v2/vercel-ai": { "types": "./dist/v2/adapters/vercel-ai.d.ts", "import": "./dist/v2/adapters/vercel-ai.js" },
    "./v2/claude-agent-sdk": { "types": "./dist/v2/adapters/claude-agent-sdk.d.ts", "import": "./dist/v2/adapters/claude-agent-sdk.js" },
    "./v2/executor": { "types": "./dist/v2/executor.d.ts", "import": "./dist/v2/executor.js" },
    "./verify": { "types": "./dist/verify/index.d.ts", "import": "./dist/verify/index.js" }
  },
  "bin": { "tracekit": "bin/tracekit.mjs" },
  "files": ["dist", "bin", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p . && node scripts/verify-page.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "@cygnuxlabs/tracekit-signer-darwin-arm64": "1.5.0",
    "@cygnuxlabs/tracekit-signer-linux-x64-gnu": "1.5.0",
    "@cygnuxlabs/tracekit-signer-linux-arm64-gnu": "1.5.0",
    "@cygnuxlabs/tracekit-signer-win32-x64": "1.5.0"
  },
  "peerDependencies": { "@openai/agents": ">=0.20.0", "ai": ">=7.0.0", "@anthropic-ai/claude-agent-sdk": ">=0.3.0" },
  "peerDependenciesMeta": {
    "@openai/agents": { "optional": true }, "ai": { "optional": true }, "@anthropic-ai/claude-agent-sdk": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "openai": "*",
    "@anthropic-ai/sdk": "*"
  },
  "repository": { "type": "git", "url": "https://github.com/Cygnux-Labs/Tracekit" },
  "homepage": "https://github.com/Cygnux-Labs/Tracekit#readme",
  "bugs": "https://github.com/Cygnux-Labs/Tracekit/issues"
}
