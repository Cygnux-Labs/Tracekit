  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "openai": "*",
    "@anthropic-ai/sdk": "*"
  },
  "repository": { "type": "git", "url": "https://github.com/Cygnux-Labs/Tracekit" }
