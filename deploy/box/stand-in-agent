#!/usr/bin/env python3
"""A stand-in for Claude Code in the box image (deploy/box/Dockerfile): runs each argument as a Bash tool call through
the hooks in Claude Code's managed settings, as Claude Code runs them: SessionStart; per call PreToolUse, the command
if the hooks let it through, PostToolUse; then SessionEnd.

    stand-in-agent 'ls -la' 'git status'
"""
import json
import os
import subprocess
import sys
import uuid

SETTINGS = "/etc/claude-code/managed-settings.json"
SESSION = str(uuid.uuid4())


def hook(event, **fields):
    """The exit code of the first of `event`'s hooks that fails, else 0; the hooks' stderr is ours."""
    with open(SETTINGS, encoding="utf-8") as f:
        groups = json.load(f)["hooks"].get(event, [])
    payload = json.dumps({"hook_event_name": event, "session_id": SESSION, "cwd": os.getcwd(), **fields})
    for h in (h for g in groups for h in g["hooks"]):
        code = subprocess.run(h["command"], shell=True, input=payload, text=True).returncode
        if code:
            return code
    return 0


def main(commands):
    hook("SessionStart", source="startup")
    worst = 0
    for i, command in enumerate(commands):
        call = {"tool_name": "Bash", "tool_input": {"command": command}, "tool_use_id": f"toolu_standin_{i}"}
        if hook("PreToolUse", **call):
            print(f"stand-in-agent: blocked: {command}", file=sys.stderr)
            worst = 2
            continue
        p = subprocess.run(command, shell=True, capture_output=True, text=True)
        sys.stdout.write(p.stdout)
        sys.stderr.write(p.stderr)
        hook("PostToolUse", **call, tool_response={"stdout": p.stdout[-4000:], "stderr": p.stderr[-4000:],
                                                   "exit_code": p.returncode})
        worst = worst or p.returncode
    hook("SessionEnd", reason="exit")
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
