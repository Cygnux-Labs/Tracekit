 {
  "name": "apply_patch, a unified diff",
  "payload": {
   "env": {
    "JCODE_HOOKS_DISABLED": "1",
    "JCODE_HOOK_CWD": "/w",
    "JCODE_HOOK_EVENT": "pre_tool",
