 {
  "name": "apply_patch, Codex's format: every file it adds or updates",
  "payload": {
   "env": {
    "JCODE_HOOKS_DISABLED": "1",
    "JCODE_HOOK_CWD": "/w",
    "JCODE_HOOK_EVENT": "pre_tool",
    "JCODE_HOOK_PAYLOAD": "{\"cwd\":\"/w\",\"event\":\"pre_tool\",\"session_id\":\"session_rec_1\",\"tool_input\":\"{\\\"patch_text\\\":\\\"*** Begin Patch\\\\n*** Add File: added.txt\\\\n+added by a Codex-format patch\\\\n*** Update File: w.txt\\\\n@@\\\\n-uno\\\\n+one again\\\\n*** End Patch\\\"}\",\"tool_name\":\"apply_patch\"}",
    "JCODE_HOOK_SESSION_ID": "session_rec_1",
    "JCODE_HOOK_TOOL_INPUT": "{\"patch_text\":\"*** Begin Patch\\n*** Add File: added.txt\\n+added by a Codex-format patch\\n*** Update File: w.txt\\n@@\\n-uno\\n+one again\\n*** End Patch\"}",
    "JCODE_HOOK_TOOL_NAME": "apply_patch"
   },
   "stdin": "{\"patch_text\":\"*** Begin Patch\\n*** Add File: added.txt\\n+added by a Codex-format patch\\n*** Update File: w.txt\\n@@\\n-uno\\n+one again\\n*** End Patch\"}"
  },
  "event": "PreToolUse",
  "decision": "allow",
  "exit": 0,
  "stdout": "",
  "request": {
   "tool": "Edit",
   "args": {
    "patch_text": "*** Begin Patch\n*** Add File: added.txt\n+added by a Codex-format patch\n*** Update File: w.txt\n@@\n-uno\n+one again\n*** End Patch",
    "file_path": "added.txt",
    "paths": [
     "added.txt",
     "w.txt"
    ]
