    "JCODE_HOOK_SESSION_ID": "session_rec_1",
    "JCODE_HOOK_TOOL_INPUT": "{\"patch_text\":\"--- a/w.txt\\n+++ b/w.txt\\n@@ -1,2 +1,2 @@\\n one again\\n-dos\\n+two again\\n\"}",
    "JCODE_HOOK_TOOL_NAME": "apply_patch"
   },
   "stdin": "{\"patch_text\":\"--- a/w.txt\\n+++ b/w.txt\\n@@ -1,2 +1,2 @@\\n one again\\n-dos\\n+two again\\n\"}"
  },
  "event": "PreToolUse",
  "decision": "allow",
  "exit": 0,
  "stdout": "",
  "request": {
   "tool": "Edit",
   "args": {
    "patch_text": "--- a/w.txt\n+++ b/w.txt\n@@ -1,2 +1,2 @@\n one again\n-dos\n+two again\n",
    "file_path": "w.txt",
    "paths": [
     "w.txt"
    ]
   },
   "tool_call_id": null
  }
