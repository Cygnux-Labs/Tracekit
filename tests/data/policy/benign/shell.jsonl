{"tool": "Bash", "args": {"command": "mongosh \"mongodb://db.internal:27017/shop\" --quiet --eval \"db.users.deleteMany({status: \\\"old\\\"})\""}, "expect": "allow", "note": "delete scoped documents through mongosh, non-empty filter"}
{"tool": "Bash", "args": {"command": "redis-cli -h flushall GET k"}, "expect": "allow", "note": "flushall as a hostname value, not the command"}
{"tool": "Bash", "args": {"command": "psql postgresql://app@db.internal:5432/shop -c \"SELECT 'DROP TABLE x'\""}, "expect": "allow", "note": "destructive keyword inside a quoted literal"}
{"tool": "Bash", "args": {"command": "grep -rn \"DROP TABLE\" ."}, "expect": "allow", "note": "destructive keyword in a grep, not a client call"}
{"tool": "Bash", "args": {"command": "git commit -m \"DROP TABLE users; TRUNCATE sessions\""}, "expect": "allow", "note": "destructive keywords in a commit message"}
{"tool": "Bash", "args": {"command": "echo \"remember to run FLUSHDB later\" | redis-cli -h cache.internal -n 0"}, "expect": "allow", "note": "flush word inside a sentence piped into redis-cli"}
{"tool": "Bash", "args": {"command": "grep -r FLUSHDB . | redis-cli -h cache.internal -n 0"}, "expect": "allow", "note": "grep hits piped into redis-cli, not a flush command"}
{"tool": "Bash", "args": {"command": "cat flush.txt | redis-cli -h cache.internal"}, "expect": "allow", "note": "file content piped into redis-cli is not read"}
{"tool": "Bash", "args": {"command": "mysql -h prod-db.internal -u app -e \"START TRANSACTION; DELETE FROM audit_log WHERE created_at < '2020-01-01'; ROLLBACK;\" shop"}, "expect": "allow", "note": "scoped DELETE inside a rolled-back transaction with a trailing database name"}
