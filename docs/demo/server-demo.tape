# vhs docs/demo/server-demo.tape (from the repo root, with tracekit-ai[signer] installed)
Output docs/demo/server-demo.gif
Set Shell "bash"
Set FontSize 15
Set Width 1700
Set Height 1060
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Hide
Type "cd docs/demo && export PS1='$ ' PACE=1.1 && clear"
Enter
Sleep 1s
Show
Sleep 800ms
Type "# Tracekit: tamper-evident records of what an AI agent did, with policy enforced outside the agent"
Enter
Sleep 1.5s
Type "python support_agent.py"
Sleep 600ms
Enter
Sleep 40s
